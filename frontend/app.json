{
  "expo": {
    "name": "FYP Frontend",
    "slug": "fyp-frontend",
    "scheme": "fypfrontend",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FYP Frontend to access your photos so you can upload product images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.hayleamlak.fypfrontend"
    }
  }
}
